# MySQL local — ya tienes el contenedor cmr-mysql corriendo (docker-compose.yml
# de cmr-proyect), así que reutilizamos esa misma instancia con una BD propia.
DATABASE_URL="mysql://root:root123@127.0.0.1:3306/pos_db"

# Puerto donde escucha el backend local (la webview de Tauri le pega aquí)
PORT=4000

# Secretos JWT — generar uno distinto por instalación
JWT_SECRET="changeme-generate-a-real-secret"
JWT_EXPIRES_IN="12h"

BUSINESS_NAME="Mi Negocio"

# --- Sincronización con el CRM (api-gateway-node) ---
# En dev, el gateway corre en localhost:8080 (ver cmr-proyect/docker-compose.yml).
ADMIN_API_BASE_URL="http://localhost:8080"

# Ya NO hace falta email/password fijo: las credenciales nacen del
# emparejamiento (pantalla "Configurar POS" -> código de 6 dígitos que se
# genera en el CRM, en Establecimientos > Puntos de emisión). Se guardan
# solas en la tabla pos_config tras emparejar, no en este .env.

# Cada cuánto se intenta sincronizar (formato cron). Por defecto cada 5 minutos.
SYNC_CRON="*/5 * * * *"

# Identificador único de esta instalación/caja (útil para trazabilidad futura)
TERMINAL_ID="pos-001"

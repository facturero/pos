# MySQL local (instalado en el mismo equipo, bindeado a 127.0.0.1)
DATABASE_URL="mysql://pos_app:changeme@127.0.0.1:3306/pos_db"

# Puerto donde escucha el backend local (la webview de Tauri le pega aquí)
PORT=4000

# Secretos JWT — generar uno distinto por instalación
JWT_SECRET="changeme-generate-a-real-secret"
JWT_EXPIRES_IN="12h"

BUSINESS_NAME="Mi Negocio"

# --- Sincronización con el admin central (fuente de verdad de productos/precios) ---
ADMIN_API_BASE_URL="https://tu-admin.tudominio.com/api"
ADMIN_API_TOKEN="token-o-api-key-del-admin"

# Cada cuánto se intenta sincronizar (formato cron). Por defecto cada 5 minutos.
SYNC_CRON="*/5 * * * *"

# Identificador único de esta instalación/caja (útil para trazabilidad en el admin)
TERMINAL_ID="pos-001"

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS",
  "version": "0.1.0",
  "identifier": "com.tunegocio.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "POS",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4000 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.tudominio.com/pos/{{target}}/{{arch}}/latest.json"
      ],
      "pubkey": "REEMPLAZAR_CON_TU_CLAVE_PUBLICA_MINISIGN"
    }
  }
}

{
  "name": "pos-desktop",
  "version": "0.3.12",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node scripts/fetch-node.mjs && node scripts/stage-backend.mjs",
    "build:win": "npm run prepare:resources && electron-builder --win",
    "pack": "npm run prepare:resources && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.noahsolution.pos",
    "productName": "POS Desktop",
    "directories": {
      "output": "out"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "stage/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "POS-Desktop-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "facturero",
        "repo": "pos"
      }
    ]
  },
  "description": "POS Desktop (Windows) — el mismo POS que el kiosco, como app instalable",
  "author": "noahsolutions",
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}

{
  "name": "pos-desktop",
  "version": "0.0.1",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node scripts/fetch-node.mjs && node scripts/stage-backend.mjs",
    "build:win": "npm run prepare:resources && electron-builder --win",
    "pack": "npm run prepare:resources && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.noahsolution.pos",
    "productName": "POS Desktop",
    "directories": {
      "output": "out"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "stage/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
